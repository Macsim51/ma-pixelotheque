# Modèle public : ne jamais conserver un vrai secret dans le dépôt/documentroot.
# Voir scripts/init_env.py et passer --env-file /chemin/prive/app.env à Compose.
DJANGO_SECRET_KEY=
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=
DJANGO_DEBUG=False

# Vide à la racine ; /ma-pixelotheque pour une publication dans ce sous-chemin.
# Le reverse proxy retire ce préfixe avant de transmettre la requête.
APP_BASE_PATH=
APP_HTTPS=False
# True seulement derrière un proxy contrôlé qui remplace X-Forwarded-Proto.
TRUST_PROXY_HTTPS=False
TZ=Europe/Paris
# Optionnel : autre fournisseur de tuiles, ou vide pour désactiver les tuiles.
# Les groupes de photos restent visibles. Respecter la politique du fournisseur.
MAP_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png

# UID/GID propriétaires des volumes hôte ; changer implique un nouveau build.
APP_UID=1000
APP_GID=1000
DATA_DIR=./var/data
MEDIA_DIR=./var/media

# Accès local par défaut. Le proxy Docker utilise l'override sans port publié.
BIND_ADDRESS=127.0.0.1
WEB_PORT=8000
PIXEL_IMAGE=ma-pixelotheque:local
